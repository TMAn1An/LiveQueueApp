NODE_ENV=development
PORT=4000

# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Optional: separate database for the test suite. Falls back to DATABASE_URL if unset.
# Recommended to point at a dedicated *_test database, since tests truncate tables.
TEST_DATABASE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# V2 Checkpoint 7 — keys the service-start verification-code cipher. A
# separate secret from JWT_SECRET on purpose (see utils/otp.ts). Generate the
# same way as JWT_SECRET above; never reuse the same value for both.
OTP_SECRET=

CORS_ORIGINS=http://localhost:5173

BCRYPT_SALT_ROUNDS=12

# Rate limiting (Phase 7). windowMs in milliseconds, max = requests allowed per window per IP.
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_TOKEN_CREATE_WINDOW_MS=60000
RATE_LIMIT_TOKEN_CREATE_MAX=10
RATE_LIMIT_SENSITIVE_WINDOW_MS=900000
RATE_LIMIT_SENSITIVE_MAX=30
RATE_LIMIT_REPORT_WINDOW_MS=900000
RATE_LIMIT_REPORT_MAX=10

# Firebase Cloud Messaging (Phase 7 — backend push dispatch).
# Exactly one of these two is needed — leave both unset to run the backend
# without push notifications (Admin SDK initialization is skipped
# gracefully, matching the mobile app's own guarded FCM behavior).
#
# FIREBASE_CREDENTIALS: the entire service-account JSON file's content,
# pasted as this variable's value. Use this on a stateless host (Render,
# etc.) that has no way to mount a plain env var as a file. Takes priority
# over FIREBASE_SERVICE_ACCOUNT_PATH if both are set.
FIREBASE_CREDENTIALS=
# FIREBASE_SERVICE_ACCOUNT_PATH: path to a local service-account JSON file
# (NEVER commit this file; see .gitignore's "*service-account*.json" rule).
# Local-dev convenience only, for when the downloaded key already sits on
# disk.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Scheduled reminder dispatch (Phase 7 — node-cron). Standard 5-field cron
# expression. Default runs every minute, since reminders must fire within a
# narrow "at least 2 minutes before turn" window.
REMINDER_DISPATCH_CRON=*/1 * * * *

# Email verification (V2 Checkpoint 2 — Resend). Leave RESEND_API_KEY unset
# to run the backend without sending real verification emails (guarded,
# same pattern as the Firebase variables above — logs a warning, never a
# startup failure).
RESEND_API_KEY=
# 'onboarding@resend.dev' works without a verified sending domain — fine for
# local dev, replace with a real verified sender in production.
EMAIL_FROM=LiveQueue <onboarding@resend.dev>
# The dashboard's own origin — verification links point here, not at this API.
APP_BASE_URL=http://localhost:5173

# Resend-verification-email rate limiting — deliberately tighter than the
# other limiters above to prevent email abuse (a real email is sent, unlike
# every other rate-limited endpoint in this file).
RATE_LIMIT_EMAIL_WINDOW_MS=900000
RATE_LIMIT_EMAIL_MAX=3

# Pending-registration cleanup (V2 Checkpoint 2 — node-cron). Deletes an
# unverified registration (organization + owner together) once its 1-hour
# window lapses. Every 5 minutes is granular enough for an hour-scale deadline.
PENDING_REGISTRATION_CLEANUP_CRON=*/5 * * * *

# Mobile version policy (V2 Checkpoint 9 — Android only, see ADR-031).
# Server-authoritative: the mobile app blocks itself when its installed
# version is below MOBILE_ANDROID_MIN_VERSION. All defaults below match the
# currently shipped app version (pubspec.yaml 1.0.0+1) with force-update
# off, so leaving these unset keeps the mechanism inactive and does not lock
# out any existing installed user. Changing any of these requires a backend
# environment update + redeploy — there is no runtime/admin UI for this.
MOBILE_ANDROID_MIN_VERSION=1.0.0
MOBILE_ANDROID_LATEST_VERSION=1.0.0
MOBILE_ANDROID_FORCE_UPDATE=false
# No default — the app has no real Play Store listing yet. Set this before
# ever raising MOBILE_ANDROID_MIN_VERSION above the installed base.
MOBILE_ANDROID_STORE_URL=
MOBILE_ANDROID_UPDATE_MESSAGE=A new version of LiveQueue is available.
