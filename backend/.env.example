NODE_ENV=development
PORT=4000

# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Optional: separate database for the test suite. Falls back to DATABASE_URL if unset.
# Recommended to point at a dedicated *_test database, since tests truncate tables.
TEST_DATABASE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

CORS_ORIGINS=http://localhost:5173

BCRYPT_SALT_ROUNDS=12
