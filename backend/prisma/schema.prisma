generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum StaffRole {
  OWNER
  ADMIN
  STAFF
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  /// V2 Checkpoint 2 (ADR-024): a just-registered owner starts here, not
  /// ACTIVE, until they prove ownership of the supplied email address.
  /// Never set by createStaff/updateStaff (staff invites remain instantly
  /// ACTIVE, unchanged from V1) — only register() uses this value.
  PENDING_EMAIL_VERIFICATION
}

enum QueueStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum CounterStatus {
  ACTIVE
  ON_BREAK
  OFFLINE
}

/// Lowercase to match the wire format used throughout the spec's form-field
/// JSON examples (e.g. "type": "phone") — deliberately not uppercase like the
/// other status enums, to avoid a translation layer between API and storage.
enum FormFieldType {
  text
  number
  email
  phone
  date
  dropdown
  radio
  checkbox
}

enum TokenStatus {
  WAITING
  CALLED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  /// V2 Checkpoint 7: customer-initiated abandonment, distinct from SKIPPED
  /// (staff-initiated). Only reachable from WAITING/CALLED — once
  /// IN_PROGRESS begins, cancellation is forbidden (see tokenStateMachine.ts).
  /// Does not consume the allowRepeatVisits allowance (only COMPLETED does)
  /// and is never recallable (see callToken's requireSourceStatus).
  CANCELLED
}

/// Device identity is deliberately global (no organizationId) per spec 7.19 /
/// ADR-011 — a device is a lightweight per-installation identifier, not a
/// tenant-scoped account.
enum DeviceStatus {
  ACTIVE
  BLOCKED
}

/// A tenant. Every organization-owned record must trace back to one Organization,
/// and every organization-scoped query must be filtered by the authenticated
/// staff member's organizationId — never by a client-supplied id.
model Organization {
  id                    String             @id @default(uuid())
  name                  String
  status                OrganizationStatus @default(ACTIVE)
  /// ADR-035: the IANA zone this organization operates in, and the default
  /// every one of its queues inherits. Initialized from the browser of the
  /// person setting the organization up — that is the admin's computer, not
  /// a surveyed location, so it is a starting suggestion they can correct in
  /// settings, never something presented as authoritative. Nullable because
  /// every organization that predates this had no such value.
  timezone              String?
  /// V2 Product Completion checkpoint, Part C: null means the owner has not
  /// finished (or has never seen) the first-time dashboard tutorial — that
  /// is the trigger to show it, not a separate boolean, so "shown but not
  /// finished" and "never shown" don't need two fields to distinguish.
  /// Every organization that existed before this checkpoint was backfilled
  /// to non-null by its own migration, so nobody already running the
  /// dashboard is unexpectedly walked through onboarding; only an
  /// organization created after this shipped starts null. An owner can
  /// return here at will via "Restart tutorial" (OrganizationSettingsPage),
  /// which simply clears it again — this never touches queues, staff, or
  /// any other organization data.
  onboardingCompletedAt DateTime?          @map("onboarding_completed_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  staff          Staff[]
  queues         Queue[]
  tokens         Token[]
  deviceBlocks   OrganizationDeviceBlock[]
  identityClaims QueueIdentityClaim[]

  @@map("organizations")
}

/// email is globally unique for MVP (ADR-005): one staff identity maps to exactly
/// one organization. No cross-organization staff memberships in this phase.
model Staff {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         StaffRole
  permissions  String[]
  status       StaffStatus @default(ACTIVE)
  lastLoginAt  DateTime?   @map("last_login_at")

  /// V2 Checkpoint 2 (ADR-024) — only ever populated while status is
  /// PENDING_EMAIL_VERIFICATION; all three are cleared back to null on
  /// successful verification. Only the hash is ever persisted (never the
  /// raw token), same pattern as Session.refreshTokenHash.
  emailVerificationTokenHash String?   @map("email_verification_token_hash")
  /// 15-minute verification-link expiry — independent of registrationExpiresAt.
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")
  /// 1-hour pending-registration deadline, set once at registration and never
  /// extended by a resend — the cleanup scheduler deletes the organization
  /// (cascading to this row) once this passes while still unverified.
  registrationExpiresAt      DateTime? @map("registration_expires_at")

  /// ADR-035 staff invitations. A deliberately separate slot from the three
  /// registration columns above, even though the token shape is identical:
  /// both flows leave an account PENDING_EMAIL_VERIFICATION, so sharing one
  /// slot would let an invitation link be redeemed at the registration
  /// endpoint — activating an account whose password nobody has ever set and
  /// burning the invitation in the process. Only the hash is stored.
  invitationTokenHash String?   @map("invitation_token_hash")
  invitationExpiresAt DateTime? @map("invitation_expires_at")
  /// When the most recent invitation was sent, which is what the resend
  /// cooldown is measured from. Null for an account that was never invited
  /// (every owner, and every staff member created before ADR-035).
  invitationSentAt    DateTime? @map("invitation_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions Session[]
  counters Counter[]

  @@index([organizationId])
  @@map("staff")
}

/// DB-backed refresh session (ADR-013). Only a SHA-256 hash of the refresh token
/// is stored, never the raw token. Rotation on use: the presented session is
/// revoked and replaced by a new row linked via replacedBySessionId. Presenting
/// an already-revoked token's hash is treated as token reuse.
model Session {
  id      String @id @default(uuid())
  staffId String @map("staff_id")
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique @map("refresh_token_hash")

  createdAt           DateTime  @default(now()) @map("created_at")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedBySessionId String?   @map("replaced_by_session_id")

  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")

  @@index([staffId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A queue represents one service line, owned by exactly one Organization.
/// deletedAt is archival state (ADR-012) and is intentionally independent of
/// `status` — a queue is never "deleted" via status, and status is never
/// implied by deletedAt (ADR-015).
model Queue {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name                       String
  description                String?
  status                     QueueStatus @default(ACTIVE)
  clientTerminology          String?     @map("client_terminology")
  tokenPrefix                String      @map("token_prefix")
  startingNumber             Int         @default(1) @map("starting_number")
  nextTokenNumber            Int         @default(1) @map("next_token_number")
  baseTimeMinutes            Int         @default(5) @map("base_time_minutes")
  defaultNotificationMinutes Int         @default(10) @map("default_notification_minutes")
  formVersion                Int         @default(1) @map("form_version")
  /// V2 Checkpoint 6: when false, a device with a COMPLETED token in this
  /// queue may not create another (see token.service.ts::createToken).
  /// SKIPPED never counts — only COMPLETED. Defaults true so every existing
  /// production queue keeps today's behavior unchanged.
  allowRepeatVisits          Boolean     @default(true) @map("allow_repeat_visits")
  /// V2 Checkpoint 6: when false, a token in this queue may select exactly
  /// one service (validated backend-side in createToken, never trusting the
  /// UI). Defaults true, preserving V2 Checkpoint 5's multi-service
  /// selection unchanged for every existing queue.
  allowMultipleServices      Boolean     @default(true) @map("allow_multiple_services")

  /// How often one customer may use this queue, when allowRepeatVisits is
  /// false. Null on a restricted queue means the identity policy has not
  /// been configured yet — such a queue refuses new joins rather than
  /// falling back to the old installation-based rule, which a reinstall
  /// could bypass (see ADR-034).
  /// DEPRECATED by ADR-035, retained rather than dropped so the original
  /// choice stays readable after the migration rewrote it into the columns
  /// below. Nothing reads it any more; nothing writes it any more.
  repeatRestrictionPeriod RepeatRestrictionPeriod? @map("repeat_restriction_period")

  /// ADR-035: how the restriction is expressed. Null on a restricted queue
  /// means the policy has not been configured yet, exactly as before.
  ///  - ONCE_EVER      — one visit, permanently.
  ///  - DURATION       — a wait measured from the completed visit.
  ///  - UNTIL_DATETIME — a fixed cutoff instant shared by everyone.
  repeatRestrictionType   RepeatRestrictionType? @map("repeat_restriction_type")
  /// DURATION only. Together these mean "may return after 1 month" etc.
  repeatRestrictionAmount Int?                   @map("repeat_restriction_amount")
  repeatRestrictionUnit   RepeatRestrictionUnit? @map("repeat_restriction_unit")
  /// UNTIL_DATETIME only. Stored as an absolute instant, converted from the
  /// queue-local date and time the admin entered — so it does not drift if
  /// the queue's timezone is later corrected.
  repeatRestrictionUntil  DateTime?              @map("repeat_restriction_until")
  /// Which persistent detail identifies the customer for that restriction.
  /// Deliberately has no device/installation option: an app reinstall must
  /// never reset a repeat restriction.
  repeatIdentityMode      RepeatIdentityMode?    @map("repeat_identity_mode")
  /// The `key` of the QueueFormField used as the custom identity, when the
  /// mode includes CUSTOM_FIELD. Stored as the key rather than a row id so
  /// it survives the form-version rewrite that editing the form performs.
  repeatIdentityFieldKey  String?                @map("repeat_identity_field_key")
  /// IANA zone for this queue. ADR-035: no longer chosen from a dropdown in
  /// the repeat-visit settings — it is initialized automatically and lives
  /// under the queue's own settings as an override of the organization's
  /// zone, which is what most queues use. Null means "inherit the
  /// organization's". Still stored rather than derived per request: a
  /// restriction has to mean the same thing on every call, and it must never
  /// depend on where the customer happens to be standing.
  timezone                String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  services           QueueService[]
  counters           Counter[]
  formFields         QueueFormField[]
  tokens             Token[]
  identityClaims     QueueIdentityClaim[]
  PhoneVerification  PhoneVerification[]
  emailVerifications CustomerEmailVerification[]

  @@index([organizationId])
  @@map("queues")
}

model QueueService {
  id      String @id @default(uuid())
  queueId String @map("queue_id")
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  serviceName     String  @map("service_name")
  description     String?
  durationMinutes Int     @map("duration_minutes")
  isActive        Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Legacy single-service relation (Token.serviceId) — see V2 Checkpoint 5
  /// / ADR-027. Kept alongside `tokenServices` during the transition; do not
  /// remove without first confirming every Token.serviceId read site has
  /// moved to the full `tokenServices` set.
  tokens        Token[]
  /// The authoritative multi-service selection (V2 Checkpoint 5, ADR-027).
  tokenServices TokenService[]

  @@index([queueId])
  @@map("queue_services")
}

model Counter {
  id      String @id @default(uuid())
  queueId String @map("queue_id")
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  name    String
  status  CounterStatus @default(OFFLINE)
  /// A staff member may hold at most one counter at a time — physically they
  /// can only stand at one. Enforced at the database level rather than by the
  /// service's pre-check alone: two admins assigning the same free person
  /// concurrently would both pass a read-then-write check. PostgreSQL treats
  /// NULLs as distinct in a unique index, so any number of counters may sit
  /// unassigned.
  staffId String?       @unique @map("staff_id")
  staff   Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tokens Token[]

  @@index([queueId])
  @@index([staffId])
  @@map("counters")
}

/// Versioned per ADR-009: a PUT replace never mutates or deletes existing
/// rows — it writes a new set of rows at `version = Queue.formVersion + 1`
/// and bumps Queue.formVersion, both inside one transaction. Old versions
/// stay exactly as they were, so historical Token.formData (added in a later
/// phase) always resolves against the field definitions it was submitted
/// under.
model QueueFormField {
  id      String @id @default(uuid())
  queueId String @map("queue_id")
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  key         String
  label       String
  type        FormFieldType
  required    Boolean       @default(false)
  placeholder String?
  options     String[]      @default([])
  sortOrder   Int           @default(0) @map("sort_order")
  version     Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([queueId, version, key])
  @@index([queueId, version])
  @@map("queue_form_fields")
}

/// One row per mobile installation (ADR-011). No organizationId: a device is
/// not a tenant-scoped identity, it is a lightweight abuse-prevention handle
/// the customer-facing token API resolves/creates on demand.
model Device {
  id               String       @id @default(uuid())
  deviceIdentifier String       @unique @map("device_identifier")
  status           DeviceStatus @default(ACTIVE)
  lastSeenAt       DateTime?    @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tokens                  Token[]
  fcmToken                DeviceFcmToken?
  notificationPreferences NotificationPreference[]
  organizationBlocks      OrganizationDeviceBlock[]

  @@map("devices")
}

/// Organization-scoped block relationship — the authoritative source for
/// device blocking (see token.service.ts::createToken). Device remains a
/// deliberately global identity (see comment above); this join table is what
/// lets Organization A block a device without affecting Organization B/C,
/// via the compound unique key. Device.status/DeviceStatus.BLOCKED are
/// intentionally left in place, unused for authorization — removing them and
/// backfilling historical blocks into this table are separate, deferred,
/// reviewed operations, not part of this change.
model OrganizationDeviceBlock {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deviceId       String       @map("device_id")
  device         Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([organizationId, deviceId])
  @@map("organization_device_blocks")
}

/// sequenceNumber is the atomically-allocated integer (ADR-003); serialNumber
/// is the derived display string (tokenPrefix + zero-padded sequenceNumber).
/// formVersion is a plain integer snapshot of Queue.formVersion at creation
/// time — not a foreign key — so historical form definitions stay resolvable
/// (queueId, version) even after the queue's live form changes (ADR-009).
model Token {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queueId        String       @map("queue_id")
  queue          Queue        @relation(fields: [queueId], references: [id], onDelete: Cascade)
  /// LEGACY single-service FK (pre-V2-Checkpoint-5). Still written on every
  /// create — set to the first service in the customer's selection — so any
  /// code path (including an old, not-yet-updated mobile app) that still
  /// reads Token.serviceId directly keeps working. The authoritative,
  /// complete selection is `tokenServices` (V2 Checkpoint 5, ADR-027); do
  /// not add new reads of this field going forward.
  serviceId      String       @map("service_id")
  service        QueueService @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  counterId      String?      @map("counter_id")
  counter        Counter?     @relation(fields: [counterId], references: [id], onDelete: SetNull)
  deviceId       String       @map("device_id")
  device         Device       @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  sequenceNumber Int         @map("sequence_number")
  serialNumber   String      @map("serial_number")
  status         TokenStatus @default(WAITING)

  formData    Json @map("form_data")
  formVersion Int  @map("form_version")

  idempotencyKey String @map("idempotency_key")

  createdAt   DateTime  @default(now()) @map("created_at")
  calledAt    DateTime? @map("called_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  skippedAt   DateTime? @map("skipped_at")
  /// V2 Checkpoint 7 — set only on a customer-initiated CANCELLED transition,
  /// never overloaded onto skippedAt (SKIPPED and CANCELLED are distinct
  /// business events with different historical meaning).
  cancelledAt DateTime? @map("cancelled_at")

  /// V2 Checkpoint 7: the CALLED -> IN_PROGRESS gate. Generated fresh every
  /// time a token enters CALLED (both /call and Recall — see callToken),
  /// cleared on successful start or on cancellation. Reversible AES-256-GCM
  /// ciphertext (utils/otp.ts), NOT a one-way hash — deliberately, so the
  /// owning customer can re-fetch the same still-valid code on a later poll
  /// without the backend ever minting a fresh one just to satisfy a read
  /// (see GET .../verification-code). Never the raw code — see utils/otp.ts's
  /// doc comment for why a one-way hash alone doesn't fit this requirement.
  /// NEVER include this column (or the two below) in any staff-facing or
  /// customer-facing serialization — see token.service.ts's omitOtpFields.
  serviceStartOtpCipher         String?   @map("service_start_otp_cipher")
  /// 5-minute default lifetime (OTP_EXPIRY_MINUTES) from generation/reissue.
  serviceStartOtpExpiresAt      DateTime? @map("service_start_otp_expires_at")
  /// Resets to 0 on every fresh generation (call/recall/reissue). At
  /// OTP_MAX_FAILED_ATTEMPTS, the current code is invalidated (cipher/expiry
  /// cleared) forcing a reissue — never a permanent token/device lock.
  serviceStartOtpFailedAttempts Int       @default(0) @map("service_start_otp_failed_attempts")

  /// V2 Checkpoint 4 (ADR-026): staff-set override of how long this specific
  /// customer's service is expected to take, in minutes. Null means "use
  /// service.durationMinutes" (the pre-existing default). Only ever set
  /// while the token is CALLED/IN_PROGRESS ("an active customer" per the
  /// product requirement) — never touched by WAITING/terminal tokens.
  requiredDurationMinutes Int? @map("required_duration_minutes")

  /// Phase 7 Step 7 dedup claim: set exactly once, via a conditional
  /// (compare-and-swap) UPDATE mirroring the existing state-machine pattern,
  /// the moment a reminder dispatch attempt claims this token — before the
  /// actual FCM send, so a crash mid-send under-delivers rather than
  /// duplicates. The smallest correct persistence for "has this token
  /// already been reminded," reusing this existing model rather than a new
  /// table (survives scheduler restarts and repeated dispatch calls, unlike
  /// an in-memory Set).
  reminderSentAt DateTime? @map("reminder_sent_at")

  /// ADR-034: the identity this token was admitted under, kept on the token
  /// itself because the claim row does not survive the whole lifecycle — a
  /// skip deletes it (the customer was not served, so they may rejoin), and
  /// a Recall brings that same token back to be served. Without this, a
  /// recalled-then-completed visit left no claim at all and the restriction
  /// was silently bypassed. Null for any token on an unrestricted queue.
  ///
  /// The fingerprint is the same HMAC stored on the claim — never the raw
  /// national ID or phone number. The period key is the one resolved at join
  /// time, so a visit that straddles midnight still belongs to the period it
  /// was reserved in rather than burning the next one.
  identityFingerprint String?             @map("identity_fingerprint")
  identityPeriodKey   String?             @map("identity_period_key")
  identityMode        RepeatIdentityMode? @map("identity_mode")

  notificationPreferences NotificationPreference[]
  /// At most one — this token's hold on a restricted queue (ADR-034).
  identityClaim           QueueIdentityClaim?
  /// V2 Checkpoint 5 (ADR-027): the authoritative multi-service selection —
  /// one row per selected service, backfilled from every pre-existing
  /// Token.serviceId at migration time. Always non-empty for every token,
  /// old and new alike.
  tokenServices           TokenService[]

  @@unique([queueId, sequenceNumber])
  @@unique([deviceId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([queueId, status, createdAt])
  @@index([deviceId])
  @@index([counterId])
  // The reminder scheduler runs globally (not organization-scoped) every
  // minute, selecting "currently WAITING, not yet reminded" tokens across
  // every organization — without this, that query would scan every
  // historical COMPLETED/SKIPPED token in the table each run.
  @@index([status, reminderSentAt])
  @@map("tokens")
}

/// V2 Checkpoint 5 (ADR-027): the customer's multi-service selection for one
/// token. A pure join table — composite primary key is the natural unique
/// constraint, no surrogate id needed. `onDelete: Restrict` on `service`
/// mirrors Token.serviceId's existing protection exactly (a service
/// referenced by any historical token, via either relation, cannot be
/// deleted) — deliberately not weakened by this migration.
model TokenService {
  tokenId String @map("token_id")
  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  serviceId String       @map("service_id")
  service   QueueService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([tokenId, serviceId])
  @@index([serviceId])
  @@map("token_services")
}

/// Phase 7 Step 7: one current FCM registration token per device. A device's
/// token can rotate (reinstall, Firebase-initiated refresh) — registering a
/// new one replaces the old one via upsert, never accumulates rows.
model DeviceFcmToken {
  id       String @id @default(uuid())
  deviceId String @unique @map("device_id")
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  fcmToken String @unique @map("fcm_token")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("device_fcm_tokens")
}

/// Spec §15/§29.7's own data model, implemented now because Phase 7's
/// reminder dispatch is the first feature that actually needs it — Phase 5
/// (mobile) deliberately deferred this to a device-local-only preference
/// (ADR-018), never synced to the backend. Scoped to (deviceId, tokenId),
/// exactly as specified: a customer's reminder preference is per queue-join,
/// not a single global device setting. Absence of a row is the server-side
/// opt-out signal — reminder dispatch INNER JOINs this table, so a device/
/// token with no row here is never reminded, not defaulted to "enabled."
model NotificationPreference {
  id       String @id @default(uuid())
  deviceId String @map("device_id")
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tokenId  String @map("token_id")
  token    Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  /// Spec 7.18: customer-configurable, minimum 2 minutes — enforced by Zod
  /// at the registration endpoint, not just documented here.
  reminderMinutes      Int     @map("reminder_minutes")
  vibrationEnabled     Boolean @default(true) @map("vibration_enabled")
  soundEnabled         Boolean @default(true) @map("sound_enabled")
  notificationsEnabled Boolean @default(true) @map("notifications_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([deviceId, tokenId])
  @@map("notification_preferences")
}

/// Append-only evidence trail (Phase 7 Step 4). organizationId/staffId are
/// plain scalar snapshots with deliberately NO Prisma relation to
/// Organization/Staff — an audit record is evidence of what happened, and
/// must survive both organization deletion (Organization cascades through
/// every other table via onDelete: Cascade) and staff deletion (DELETE
/// /api/staff/:staffId is a hard delete). staffEmail is captured too, so the
/// actor stays identifiable even after the Staff row is gone. `action` is a
/// plain string, not a Postgres enum, so the audit vocabulary can grow
/// without a schema migration for every new event — validated at the
/// application layer instead (src/constants/auditActions.ts).
model AuditLog {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  staffId        String @map("staff_id")
  staffEmail     String @map("staff_email")

  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")
  metadata   Json?
  ipAddress  String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

/// DEPRECATED by ADR-035 — the four fixed windows a restricted queue used to
/// choose between. Retained only because Queue.repeatRestrictionPeriod keeps
/// its historical value.
enum RepeatRestrictionPeriod {
  ONCE_EVER
  DAILY
  WEEKLY
  MONTHLY
}

/// ADR-035: how a queue expresses its repeat limit.
enum RepeatRestrictionType {
  /// One visit, permanently. Needs no timezone and no arithmetic.
  ONCE_EVER
  /// A wait measured from the moment the visit was delivered, so every
  /// customer gets the same wait regardless of when they happened to arrive.
  DURATION
  /// A single cutoff instant shared by everyone — "nobody may rejoin before
  /// 31 December, 11:59 PM".
  UNTIL_DATETIME
}

/// The unit of a DURATION restriction. MINUTE through WEEK are exact elapsed
/// time and need no timezone. MONTH and YEAR are calendar increments — one
/// month after 31 January is 28 February, not "30 days later" — so they are
/// evaluated in the queue's own zone.
enum RepeatRestrictionUnit {
  MINUTE
  HOUR
  DAY
  WEEK
  MONTH
  YEAR
}

/// Which persistent detail identifies the customer for a repeat restriction.
/// There is deliberately no device/installation option here — the generated
/// installation identifier is reset by a reinstall, so it can never be the
/// authority for "this person already came" (ADR-034).
enum RepeatIdentityMode {
  /// DEPRECATED by ADR-037. Kept because removing a PostgreSQL enum value is
  /// destructive and buys nothing: no queue can be configured with either
  /// phone mode any more, and no SMS provider was ever integrated, so these
  /// two have never identified a real customer. They stay so that a value
  /// already written to a development database still parses.
  VERIFIED_PHONE
  CUSTOM_FIELD
  VERIFIED_PHONE_AND_CUSTOM_FIELD
  /// ADR-037: the customer proves access to an email address before it can
  /// stand as their identity. Replaces the phone modes, which waited on an
  /// SMS provider that was never integrated — email delivery already works
  /// in production for account verification and staff invitations.
  VERIFIED_EMAIL
  VERIFIED_EMAIL_AND_CUSTOM_FIELD
}

enum IdentityClaimStatus {
  /// Held by a token that is still WAITING/CALLED/IN_PROGRESS. Stops the
  /// same person joining twice at once, from any number of installations.
  RESERVED
  /// The visit actually happened (COMPLETED), so the entitlement for this
  /// period is spent.
  CONSUMED
}

/// One customer's hold on a restricted queue for one restriction period.
///
/// Stores only an HMAC fingerprint of the normalized identity, never the
/// phone number or the NID/student-id itself: the raw answer already lives
/// in the token's form data under the existing staff-visible rules, and
/// duplicating it into a uniqueness table would spread it further for no
/// benefit. Two identities match iff their fingerprints match.
///
/// The unique constraint is the actual enforcement — a read-then-write
/// check cannot stop two simultaneous joins, and this rule has to hold
/// across devices, so it cannot lean on the per-installation lock either.
model QueueIdentityClaim {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queueId        String       @map("queue_id")
  queue          Queue        @relation(fields: [queueId], references: [id], onDelete: Cascade)

  /// HMAC-SHA256 over the queue id, identity mode and normalized identity
  /// material. Queue-scoped by construction, so a fingerprint is meaningless
  /// in any other queue and a policy change naturally starts a new namespace.
  identityFingerprint String  @map("identity_fingerprint")
  /// LEGACY (ADR-034): the fixed window this claim occupied — `EVER`,
  /// `2026-09-08`, `2026-W37` or `2026-09`. ADR-035 replaced fixed windows
  /// with an explicit `eligibleAgainAt`, which the migration computed from
  /// exactly these values. Kept, and now nullable, so the original window
  /// stays readable; nothing is written here any more.
  periodKey           String? @map("period_key")

  status IdentityClaimStatus @default(RESERVED)
  mode   RepeatIdentityMode

  /// When the visit was actually delivered. Null while merely RESERVED.
  consumedAt      DateTime? @map("consumed_at")
  /// When this customer may use the queue again. Null together with a
  /// non-null consumedAt means never — a once-ever queue. Meaningless while
  /// RESERVED, because an active token blocks regardless.
  eligibleAgainAt DateTime? @map("eligible_again_at")

  /// ADR-035: exactly one claim per (queue, identity) governs eligibility at
  /// a time; older ones are kept for history rather than deleted. Rather
  /// than a partial unique index — which Prisma cannot express, and which
  /// would therefore read as schema drift forever — the live row holds the
  /// literal slot value ACTIVE while a superseded row takes its own id.
  /// Ids are unique, so history can grow without ever colliding, and the
  /// unique index below still admits only one governing claim.
  claimSlot    String    @default("ACTIVE") @map("claim_slot")
  supersededAt DateTime? @map("superseded_at")

  /// The token holding this claim. Unique so a token can never hold two.
  tokenId String @unique @map("token_id")
  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([queueId, identityFingerprint, claimSlot])
  @@index([queueId, status])
  @@index([queueId, identityFingerprint])
  @@map("queue_identity_claims")
}

/// A phone-number verification challenge, used only to prove control of a
/// number before joining a queue that identifies customers by phone.
///
/// Deliberately separate from the service-start OTP (Token.serviceStartOtp*)
/// in every respect — different model, routes, secret purpose, lifetime and
/// attempt budget. The two prove different things to different parties and
/// must not share machinery (ADR-034).
model PhoneVerification {
  id      String @id @default(uuid())
  queueId String @map("queue_id")
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  /// Fingerprint of the normalized number, not the number itself — this row
  /// only ever needs to answer "is this the same number as before".
  phoneFingerprint String @map("phone_fingerprint")
  /// HMAC of the code. One-way: nothing ever needs to read the code back,
  /// unlike the service-start OTP, which the owning customer re-fetches.
  codeHash         String @map("code_hash")

  expiresAt      DateTime  @map("expires_at")
  failedAttempts Int       @default(0) @map("failed_attempts")
  consumedAt     DateTime? @map("consumed_at")
  /// Drives the resend cooldown without a second table.
  lastSentAt     DateTime  @default(now()) @map("last_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([queueId, phoneFingerprint])
  @@index([expiresAt])
  @@map("phone_verifications")
}

/// ADR-037: an email verification challenge, proving a customer can read a
/// mailbox before that address may stand as their repeat-visit identity.
///
/// Deliberately its own model rather than a generalisation of
/// PhoneVerification: that table is dormant (no SMS provider was ever
/// integrated) and renaming its columns would be a destructive change to
/// earn nothing. Deliberately separate from the Staff email-verification
/// columns too — proving a customer can read a mailbox is a different
/// question from an owner proving they control an account, with a different
/// lifetime, a different audience and a different secret purpose.
model CustomerEmailVerification {
  id      String @id @default(uuid())
  queueId String @map("queue_id")
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  /// Fingerprint of the normalized address, never the address itself: this
  /// row only ever has to answer "is this the same mailbox as before", and
  /// the identity system never needs a second copy of a customer's email.
  emailFingerprint String @map("email_fingerprint")
  /// HMAC of the code. One-way — nothing ever reads the code back, unlike
  /// the service-start OTP which the owning customer re-fetches.
  codeHash         String @map("code_hash")

  expiresAt      DateTime  @map("expires_at")
  failedAttempts Int       @default(0) @map("failed_attempts")
  consumedAt     DateTime? @map("consumed_at")
  /// Drives the resend cooldown without a second table.
  lastSentAt     DateTime  @default(now()) @map("last_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([queueId, emailFingerprint])
  @@index([expiresAt])
  @@map("customer_email_verifications")
}
