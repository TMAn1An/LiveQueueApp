generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

/// Shown to people as: OWNER = Organization Head, MANAGER = Organization
/// Manager, ADMIN = Admin, STAFF = Executive (ADR-069). The stored values
/// stay stable; only the labels changed.
enum StaffRole {
  OWNER
  ADMIN
  STAFF
  /// ADR-069: organization-wide governance (read everything, delete a queue
  /// with a reason). No queue operations, no invitations, no serving.
  MANAGER
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  /// V2 Checkpoint 2 (ADR-024): a just-registered owner starts here, not
  /// ACTIVE, until they prove ownership of the supplied email address.
  /// Never set by createStaff/updateStaff (staff invites remain instantly
  /// ACTIVE, unchanged from V1) — only register() uses this value.
  PENDING_EMAIL_VERIFICATION
}

enum QueueStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum CounterStatus {
  ACTIVE
  ON_BREAK
  OFFLINE
}

/// Lowercase to match the wire format used throughout the spec's form-field
/// JSON examples (e.g. "type": "phone") — deliberately not uppercase like the
/// other status enums, to avoid a translation layer between API and storage.
enum FormFieldType {
  text
  number
  email
  phone
  date
  dropdown
  radio
  checkbox
}

enum TokenStatus {
  WAITING
  CALLED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  /// V2 Checkpoint 7: customer-initiated abandonment, distinct from SKIPPED
  /// (staff-initiated). Only reachable from WAITING/CALLED — once
  /// IN_PROGRESS begins, cancellation is forbidden (see tokenStateMachine.ts).
  /// Does not consume the allowRepeatVisits allowance (only COMPLETED does)
  /// and is never recallable (see callToken's requireSourceStatus).
  CANCELLED
}

/// ADR-042: why staff skipped a customer. Deliberately short — a reason is
/// only useful if staff can pick it in a second. OTHER always carries the
/// staff's own text (Token.skipReasonText).
enum SkipReasonCode {
  CUSTOMER_NOT_PRESENT
  NO_RESPONSE
  MISSING_REQUIREMENT
  CUSTOMER_LEFT
  OTHER
}

/// Device identity is deliberately global (no organizationId) per spec 7.19 /
/// ADR-011 — a device is a lightweight per-installation identifier, not a
/// tenant-scoped account.
enum DeviceStatus {
  ACTIVE
  BLOCKED
}

/// A tenant. Every organization-owned record must trace back to one Organization,
/// and every organization-scoped query must be filtered by the authenticated
/// staff member's organizationId — never by a client-supplied id.
model Organization {
  id                    String             @id @default(uuid())
  name                  String
  /// Organization names are unique case-insensitively, like usernames
  /// (organizationName.ts). `name` keeps exactly what was typed for display;
  /// this lower-case key is what the unique index enforces.
  nameKey               String             @unique @map("name_key")
  status                OrganizationStatus @default(ACTIVE)
  /// ADR-035: the IANA zone this organization operates in, and the default
  /// every one of its queues inherits. Initialized from the browser of the
  /// person setting the organization up — that is the admin's computer, not
  /// a surveyed location, so it is a starting suggestion they can correct in
  /// settings, never something presented as authoritative. Nullable because
  /// every organization that predates this had no such value.
  timezone              String?
  /// V2 Product Completion checkpoint, Part C: null means the owner has not
  /// finished (or has never seen) the first-time dashboard tutorial — that
  /// is the trigger to show it, not a separate boolean, so "shown but not
  /// finished" and "never shown" don't need two fields to distinguish.
  /// Every organization that existed before this checkpoint was backfilled
  /// to non-null by its own migration, so nobody already running the
  /// dashboard is unexpectedly walked through onboarding; only an
  /// organization created after this shipped starts null. An owner can
  /// return here at will via "Restart tutorial" (OrganizationSettingsPage),
  /// which simply clears it again — this never touches queues, staff, or
  /// any other organization data.
  onboardingCompletedAt DateTime?          @map("onboarding_completed_at")
  /// ADR-068: the stable, non-secret code in the organization's one public
  /// QR (`/visit/{publicCode}`). Random, not derived from the id or the
  /// name, so it neither exposes the internal id nor changes when the
  /// organization or its queues are renamed. Generated by the database for
  /// every new organization; existing ones were backfilled by the migration.
  publicCode            String             @unique @default(dbgenerated("substr(md5(((random())::text || (clock_timestamp())::text)), 1, 12)")) @map("public_code")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  staff           Staff[]
  queues          Queue[]
  tokens          Token[]
  deviceBlocks    OrganizationDeviceBlock[]
  identityClaims  QueueIdentityClaim[]
  removalRequests MembershipRemovalRequest[]
  /// ADR-071: governance history. Kept for the organization's whole life and
  /// removed only with it (database triggers refuse any other change).
  headTenures     OrganizationHeadTenure[]
  headSuccessions HeadSuccession[]
  adminTransfers  AdminWorkspaceTransfer[]

  @@map("organizations")
}

/// email is globally unique for MVP (ADR-005): one staff identity maps to exactly
/// one organization. No cross-organization staff memberships in this phase.
model Staff {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         StaffRole
  permissions  String[]
  status       StaffStatus @default(ACTIVE)
  lastLoginAt  DateTime?   @map("last_login_at")

  /// V2 Checkpoint 2 (ADR-024) — only ever populated while status is
  /// PENDING_EMAIL_VERIFICATION; all three are cleared back to null on
  /// successful verification. Only the hash is ever persisted (never the
  /// raw token), same pattern as Session.refreshTokenHash.
  emailVerificationTokenHash String?   @map("email_verification_token_hash")
  /// 15-minute verification-link expiry — independent of registrationExpiresAt.
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")
  /// 1-hour pending-registration deadline, set once at registration and never
  /// extended by a resend — the cleanup scheduler deletes the organization
  /// (cascading to this row) once this passes while still unverified.
  registrationExpiresAt      DateTime? @map("registration_expires_at")

  /// ADR-035 staff invitations. A deliberately separate slot from the three
  /// registration columns above, even though the token shape is identical:
  /// both flows leave an account PENDING_EMAIL_VERIFICATION, so sharing one
  /// slot would let an invitation link be redeemed at the registration
  /// endpoint — activating an account whose password nobody has ever set and
  /// burning the invitation in the process. Only the hash is stored.
  invitationTokenHash String?   @map("invitation_token_hash")
  invitationExpiresAt DateTime? @map("invitation_expires_at")
  /// When the most recent invitation was sent, which is what the resend
  /// cooldown is measured from. Null for an account that was never invited
  /// (every owner, and every staff member created before ADR-035).
  invitationSentAt    DateTime? @map("invitation_sent_at")

  /// ADR-058: access tokens issued before this instant are refused, even
  /// though their 15-minute JWT lifetime has not run out. Set by a password
  /// reset, which also revokes every refresh session, so "sign out
  /// everywhere" takes effect at once rather than when the last access token
  /// expires. Null for every account that has never reset its password.
  accessRevokedAt DateTime? @map("access_revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// ADR-069: the Admin whose workspace this Executive (STAFF) belongs to.
  /// Null for every other role, and for Executives who predate workspaces
  /// (organization-level until the Organization Head assigns them — never
  /// guessed). If the Admin leaves, their Executives return to
  /// organization-level rather than disappearing.
  workspaceAdminId String? @map("workspace_admin_id")
  workspaceAdmin   Staff?  @relation("WorkspaceExecutives", fields: [workspaceAdminId], references: [id], onDelete: SetNull)

  sessions            Session[]
  counters            Counter[]
  passwordResetTokens PasswordResetToken[]
  executives          Staff[]              @relation("WorkspaceExecutives")
  adminQueues         Queue[]              @relation("QueueAdmin")

  @@index([organizationId])
  @@index([workspaceAdminId])
  @@map("staff")
}

/// DB-backed refresh session (ADR-013). Only a SHA-256 hash of the refresh token
/// is stored, never the raw token. Rotation on use: the presented session is
/// revoked and replaced by a new row linked via replacedBySessionId. Presenting
/// an already-revoked token's hash is treated as token reuse.
model Session {
  id      String @id @default(uuid())
  staffId String @map("staff_id")
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique @map("refresh_token_hash")

  createdAt           DateTime  @default(now()) @map("created_at")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedBySessionId String?   @map("replaced_by_session_id")

  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")

  @@index([staffId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A queue represents one service line, owned by exactly one Organization.
/// deletedAt is archival state (ADR-012) and is intentionally independent of
/// `status` — a queue is never "deleted" via status, and status is never
/// implied by deletedAt (ADR-015).
model Queue {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name                       String
  description                String?
  status                     QueueStatus @default(ACTIVE)
  clientTerminology          String?     @map("client_terminology")
  tokenPrefix                String      @map("token_prefix")
  startingNumber             Int         @default(1) @map("starting_number")
  nextTokenNumber            Int         @default(1) @map("next_token_number")
  baseTimeMinutes            Int         @default(5) @map("base_time_minutes")
  defaultNotificationMinutes Int         @default(10) @map("default_notification_minutes")
  formVersion                Int         @default(1) @map("form_version")
  /// V2 Checkpoint 6: when false, a device with a COMPLETED token in this
  /// queue may not create another (see token.service.ts::createToken).
  /// SKIPPED never counts — only COMPLETED. Defaults true so every existing
  /// production queue keeps today's behavior unchanged.
  allowRepeatVisits          Boolean     @default(true) @map("allow_repeat_visits")
  /// V2 Checkpoint 6: when false, a token in this queue may select exactly
  /// one service (validated backend-side in createToken, never trusting the
  /// UI). Defaults true, preserving V2 Checkpoint 5's multi-service
  /// selection unchanged for every existing queue. ADR-055: fixed at
  /// creation — updateQueue refuses any later change.
  allowMultipleServices      Boolean     @default(true) @map("allow_multiple_services")
  /// ADR-041: whether staff must enter the customer's service-start
  /// verification code (ADR-029) before CALLED -> IN_PROGRESS. Named for
  /// that one code on purpose — LiveQueue also has customer email
  /// verification, account verification and staff invitations, none of which
  /// this governs. ADR-055: chosen once at creation (default off) and fixed
  /// for the queue's lifetime; existing queues keep the value they had.
  requireServiceStartOtp     Boolean     @default(false) @map("require_service_start_otp")
  /// ADR-068: whether the queue appears on the organization's public page
  /// (the organization QR). Off hides it there; its own legacy queue QR and
  /// id still work. Closed/paused queues that are listed are shown disabled.
  listedOnOrganizationPage   Boolean     @default(true) @map("listed_on_organization_page")

  /// How often one customer may use this queue, when allowRepeatVisits is
  /// false. Null on a restricted queue means the identity policy has not
  /// been configured yet — such a queue refuses new joins rather than
  /// falling back to the old installation-based rule, which a reinstall
  /// could bypass (see ADR-034).
  /// DEPRECATED by ADR-035, retained rather than dropped so the original
  /// choice stays readable after the migration rewrote it into the columns
  /// below. Nothing reads it any more; nothing writes it any more.
  repeatRestrictionPeriod RepeatRestrictionPeriod? @map("repeat_restriction_period")

  /// ADR-035: how the restriction is expressed. Null on a restricted queue
  /// means the policy has not been configured yet, exactly as before.
  ///  - ONCE_EVER      — one visit, permanently.
  ///  - DURATION       — a wait measured from the completed visit.
  ///  - UNTIL_DATETIME — a fixed cutoff instant shared by everyone.
  repeatRestrictionType   RepeatRestrictionType? @map("repeat_restriction_type")
  /// DURATION only. Together these mean "may return after 1 month" etc.
  repeatRestrictionAmount Int?                   @map("repeat_restriction_amount")
  repeatRestrictionUnit   RepeatRestrictionUnit? @map("repeat_restriction_unit")
  /// UNTIL_DATETIME only. Stored as an absolute instant, converted from the
  /// queue-local date and time the admin entered — so it does not drift if
  /// the queue's timezone is later corrected.
  repeatRestrictionUntil  DateTime?              @map("repeat_restriction_until")
  /// Which persistent detail identifies the customer for that restriction.
  /// Deliberately has no device/installation option: an app reinstall must
  /// never reset a repeat restriction.
  repeatIdentityMode      RepeatIdentityMode?    @map("repeat_identity_mode")
  /// The `key` of the QueueFormField used as the custom identity, when the
  /// mode includes CUSTOM_FIELD. Stored as the key rather than a row id so
  /// it survives the form-version rewrite that editing the form performs.
  repeatIdentityFieldKey  String?                @map("repeat_identity_field_key")
  /// ADR-049: what a completed visit uses up. QUEUE (the default, and the
  /// value every existing queue gets) — the restriction applies across the
  /// whole queue, exactly as before. SESSION — a completed visit spends the
  /// allowance only for the session occurrence (weekly session + calendar
  /// date) it was assigned to; only valid while the weekly schedule is on.
  repeatRestrictionScope  RepeatRestrictionScope @default(QUEUE) @map("repeat_restriction_scope")
  /// IANA zone for this queue. ADR-035: no longer chosen from a dropdown in
  /// the repeat-visit settings — it is initialized automatically and lives
  /// under the queue's own settings as an override of the organization's
  /// zone, which is what most queues use. Null means "inherit the
  /// organization's". Still stored rather than derived per request: a
  /// restriction has to mean the same thing on every call, and it must never
  /// depend on where the customer happens to be standing.
  timezone                String?

  /// Phase 4 (schedule/sessions): off by default so every existing queue
  /// keeps accepting joins at any time, exactly as before this feature
  /// existed. A queue is "closed" for a given weekday only by having zero
  /// QueueSession rows for it — there is no separate day-open/closed flag.
  scheduleEnabled            Boolean @default(false) @map("schedule_enabled")
  /// Total joins allowed per local calendar day across every session
  /// combined. Null = unlimited. Enforced alongside (never instead of) each
  /// session's own capacity.
  scheduleDailyCapacity      Int?    @map("schedule_daily_capacity")
  /// Whether the mobile app may show today's hours / the customer's assigned
  /// session. When false, join-failure reasons still explain themselves
  /// (spec 4G) — this only hides the schedule's own detail, never the reason
  /// a join failed.
  scheduleVisibleToCustomers Boolean @default(true) @map("schedule_visible_to_customers")

  /// ADR-069: the Admin whose workspace this queue is — one live queue per
  /// Admin (partial unique index queues_admin_live_key). Null only for
  /// queues that predate workspaces ("Head-managed" until the Organization
  /// Head assigns them) or whose Admin has left; a new queue is never
  /// created without one.
  adminId String? @map("admin_id")
  admin   Staff?  @relation("QueueAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")
  /// ADR-069: who removed the queue and why. Snapshotted (not foreign keys)
  /// so the record survives the person later leaving the organization.
  /// Null on queues deleted before this was recorded.
  deletedByStaffId String?    @map("deleted_by_staff_id")
  deletedByEmail   String?    @map("deleted_by_email")
  deletedByRole    StaffRole? @map("deleted_by_role")
  deletionReason   String?    @map("deletion_reason")

  services           QueueService[]
  recommendedSteps   QueueRecommendedStep[]
  counters           Counter[]
  formFields         QueueFormField[]
  tokens             Token[]
  sessions           QueueSession[]
  identityClaims     QueueIdentityClaim[]
  PhoneVerification  PhoneVerification[]
  emailVerifications CustomerEmailVerification[]

  @@index([organizationId])
  @@index([adminId])
  @@map("queues")
}

model QueueService {
  id      String @id @default(uuid())
  queueId String @map("queue_id")
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  serviceName              String  @map("service_name")
  description              String?
  durationMinutes          Int     @map("duration_minutes")
  isActive                 Boolean @default(true) @map("is_active")
  /// ADR-070: how many times this service may appear in one person's
  /// ordered journey (never twice in a row, whatever this says).
  maxOccurrencesPerJourney Int     @default(2) @map("max_occurrences_per_journey")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Legacy single-service relation (Token.serviceId) — see V2 Checkpoint 5
  /// / ADR-027. Kept alongside `tokenServices` during the transition; do not
  /// remove without first confirming every Token.serviceId read site has
  /// moved to the full `tokenServices` set.
  tokens           Token[]
  /// The authoritative multi-service selection (V2 Checkpoint 5, ADR-027).
  tokenServices    TokenService[]
  /// ADR-070: the ordered journey steps that use this service.
  journeySteps     TokenServiceStep[]
  counterServices  CounterService[]
  recommendedSteps QueueRecommendedStep[]

  @@index([queueId])
  @@map("queue_services")
}

/// Phase 4: one recurring weekly time window a queue accepts joins in.
/// A weekday with zero rows here is a closed day — there is no separate
/// "is this day open" flag to keep in sync with the session list.
///
/// Deliberately allows two sessions on the same queue/weekday to overlap:
/// that is a supported way to model two concurrent capacity pools (e.g. two
/// parallel service tracks), not an accident to reject. The dashboard's own
/// validation only catches the shape mistakes a human can't reasonably mean
/// (end <= start, a duplicate identical session) — see
/// queueSchedule.service.ts.
model QueueSession {
  id      String @id @default(uuid())
  queueId String @map("queue_id")
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  /// 0 = Sunday .. 6 = Saturday, matching JS/Intl's `Date.getUTCDay()` so the
  /// backend never has to remember a second convention.
  weekday     Int
  /// Minutes since local midnight, evaluated in the queue's own timezone
  /// (resolveQueueTimezone) — never the server's. 0-1439.
  startMinute Int  @map("start_minute")
  /// Always > startMinute; a session cannot cross midnight (spec gives no
  /// requirement for one that does, and it would make "which day is this
  /// session's capacity counted against" ambiguous).
  endMinute   Int  @map("end_minute")
  /// Max joins for this specific session on one calendar day. Null =
  /// unlimited (still subject to the queue's overall scheduleDailyCapacity,
  /// if set).
  capacity    Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tokens Token[]

  @@index([queueId, weekday])
  @@map("queue_sessions")
}

model Counter {
  id      String @id @default(uuid())
  queueId String @map("queue_id")
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  name    String
  status  CounterStatus @default(OFFLINE)
  /// A staff member may hold at most one counter at a time — physically they
  /// can only stand at one. Enforced at the database level rather than by the
  /// service's pre-check alone: two admins assigning the same free person
  /// concurrently would both pass a read-then-write check. PostgreSQL treats
  /// NULLs as distinct in a unique index, so any number of counters may sit
  /// unassigned.
  staffId String?       @unique @map("staff_id")
  staff   Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tokens        Token[]
  /// ADR-070: the services this counter handles. None = every service of
  /// its queue (the simple default).
  services      CounterService[]
  journeySteps  TokenServiceStep[] @relation("StepCounter")
  referralsTo   TokenServiceStep[] @relation("StepReferredTo")
  referralsFrom TokenServiceStep[] @relation("StepReferredFrom")

  @@index([queueId])
  @@index([staffId])
  @@map("counters")
}

/// Versioned per ADR-009: a PUT replace never mutates or deletes existing
/// rows — it writes a new set of rows at `version = Queue.formVersion + 1`
/// and bumps Queue.formVersion, both inside one transaction. Old versions
/// stay exactly as they were, so historical Token.formData (added in a later
/// phase) always resolves against the field definitions it was submitted
/// under.
model QueueFormField {
  id      String @id @default(uuid())
  queueId String @map("queue_id")
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  key         String
  label       String
  type        FormFieldType
  required    Boolean       @default(false)
  placeholder String?
  options     String[]      @default([])
  sortOrder   Int           @default(0) @map("sort_order")
  version     Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([queueId, version, key])
  @@index([queueId, version])
  @@map("queue_form_fields")
}

/// One row per mobile installation (ADR-011). No organizationId: a device is
/// not a tenant-scoped identity, it is a lightweight abuse-prevention handle
/// the customer-facing token API resolves/creates on demand.
model Device {
  id               String       @id @default(uuid())
  deviceIdentifier String       @unique @map("device_identifier")
  status           DeviceStatus @default(ACTIVE)
  lastSeenAt       DateTime?    @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tokens                  Token[]
  fcmToken                DeviceFcmToken?
  webPushSubscriptions    WebPushSubscription[]
  notificationPreferences NotificationPreference[]
  organizationBlocks      OrganizationDeviceBlock[]

  @@map("devices")
}

/// Organization-scoped block relationship — the authoritative source for
/// device blocking (see token.service.ts::createToken). Device remains a
/// deliberately global identity (see comment above); this join table is what
/// lets Organization A block a device without affecting Organization B/C,
/// via the compound unique key. Device.status/DeviceStatus.BLOCKED are
/// intentionally left in place, unused for authorization — removing them and
/// backfilling historical blocks into this table are separate, deferred,
/// reviewed operations, not part of this change.
model OrganizationDeviceBlock {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deviceId       String       @map("device_id")
  device         Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([organizationId, deviceId])
  @@map("organization_device_blocks")
}

/// sequenceNumber is the atomically-allocated integer (ADR-003); serialNumber
/// is the derived display string (tokenPrefix + zero-padded sequenceNumber).
/// formVersion is a plain integer snapshot of Queue.formVersion at creation
/// time — not a foreign key — so historical form definitions stay resolvable
/// (queueId, version) even after the queue's live form changes (ADR-009).
model Token {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queueId        String       @map("queue_id")
  queue          Queue        @relation(fields: [queueId], references: [id], onDelete: Cascade)
  /// LEGACY single-service FK (pre-V2-Checkpoint-5). Still written on every
  /// create — set to the first service in the customer's selection — so any
  /// code path (including an old, not-yet-updated mobile app) that still
  /// reads Token.serviceId directly keeps working. The authoritative,
  /// complete selection is `tokenServices` (V2 Checkpoint 5, ADR-027); do
  /// not add new reads of this field going forward.
  serviceId      String       @map("service_id")
  service        QueueService @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  counterId      String?      @map("counter_id")
  counter        Counter?     @relation(fields: [counterId], references: [id], onDelete: SetNull)
  deviceId       String       @map("device_id")
  device         Device       @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  sequenceNumber Int         @map("sequence_number")
  serialNumber   String      @map("serial_number")
  status         TokenStatus @default(WAITING)

  formData    Json @map("form_data")
  formVersion Int  @map("form_version")

  idempotencyKey String @map("idempotency_key")

  createdAt   DateTime  @default(now()) @map("created_at")
  calledAt    DateTime? @map("called_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  skippedAt   DateTime? @map("skipped_at")
  /// V2 Checkpoint 7 — set only on a customer-initiated CANCELLED transition,
  /// never overloaded onto skippedAt (SKIPPED and CANCELLED are distinct
  /// business events with different historical meaning).
  cancelledAt DateTime? @map("cancelled_at")

  /// ADR-042: why staff skipped this customer. Required on every skip from
  /// now on; null on every token never skipped, and on skips recorded before
  /// the requirement existed (never back-filled, never invented).
  skipReasonCode     SkipReasonCode? @map("skip_reason_code")
  /// ADR-042: the wording the customer is shown — the predefined reason's
  /// label as it read at skip time, or the staff's own text for OTHER. A
  /// snapshot, so a later relabel never rewrites what a customer was told.
  skipReasonText     String?         @map("skip_reason_text")
  /// ADR-042: optional note left by staff when completing service. Null
  /// means an ordinary completion — never a second terminal state.
  completionFeedback String?         @map("completion_feedback")

  /// V2 Checkpoint 7: the CALLED -> IN_PROGRESS gate. Generated fresh every
  /// time a token enters CALLED (both /call and Recall — see callToken),
  /// cleared on successful start or on cancellation. Reversible AES-256-GCM
  /// ciphertext (utils/otp.ts), NOT a one-way hash — deliberately, so the
  /// owning customer can re-fetch the same still-valid code on a later poll
  /// without the backend ever minting a fresh one just to satisfy a read
  /// (see GET .../verification-code). Never the raw code — see utils/otp.ts's
  /// doc comment for why a one-way hash alone doesn't fit this requirement.
  /// NEVER include this column (or the two below) in any staff-facing or
  /// customer-facing serialization — see token.service.ts's omitOtpFields.
  serviceStartOtpCipher         String?   @map("service_start_otp_cipher")
  /// 5-minute default lifetime (OTP_EXPIRY_MINUTES) from generation/reissue.
  serviceStartOtpExpiresAt      DateTime? @map("service_start_otp_expires_at")
  /// Resets to 0 on every fresh generation (call/recall/reissue). At
  /// OTP_MAX_FAILED_ATTEMPTS, the current code is invalidated (cipher/expiry
  /// cleared) forcing a reissue — never a permanent token/device lock.
  serviceStartOtpFailedAttempts Int       @default(0) @map("service_start_otp_failed_attempts")

  /// V2 Checkpoint 4 (ADR-026): staff-set override of how long this specific
  /// customer's service is expected to take, in minutes. Null means "use
  /// service.durationMinutes" (the pre-existing default). Only ever set
  /// while the token is CALLED/IN_PROGRESS ("an active customer" per the
  /// product requirement) — never touched by WAITING/terminal tokens.
  requiredDurationMinutes Int? @map("required_duration_minutes")

  /// Phase 7 Step 7 dedup claim: set exactly once, via a conditional
  /// (compare-and-swap) UPDATE mirroring the existing state-machine pattern,
  /// the moment a reminder dispatch attempt claims this token — before the
  /// actual FCM send, so a crash mid-send under-delivers rather than
  /// duplicates. The smallest correct persistence for "has this token
  /// already been reminded," reusing this existing model rather than a new
  /// table (survives scheduler restarts and repeated dispatch calls, unlike
  /// an in-memory Set).
  reminderSentAt DateTime? @map("reminder_sent_at")

  /// ADR-070: which step of the ordered journey this token is on (1-based).
  /// Null for tokens created before journeys existed — those keep their
  /// original single-visit behaviour and are never converted.
  currentStepNumber Int?    @map("current_step_number")
  /// ADR-069: why a CANCELLED token was cancelled when it was not the
  /// person themselves — currently only QUEUE_REMOVED. Null otherwise.
  cancelReasonCode  String? @map("cancel_reason_code")

  /// ADR-034: the identity this token was admitted under, kept on the token
  /// itself because the claim row does not survive the whole lifecycle — a
  /// skip deletes it (the customer was not served, so they may rejoin), and
  /// a Recall brings that same token back to be served. Without this, a
  /// recalled-then-completed visit left no claim at all and the restriction
  /// was silently bypassed. Null for any token on an unrestricted queue.
  ///
  /// The fingerprint is the same HMAC stored on the claim — never the raw
  /// national ID or phone number. The period key is the one resolved at join
  /// time, so a visit that straddles midnight still belongs to the period it
  /// was reserved in rather than burning the next one.
  identityFingerprint String?             @map("identity_fingerprint")
  identityPeriodKey   String?             @map("identity_period_key")
  identityMode        RepeatIdentityMode? @map("identity_mode")
  /// ADR-049: the entitlement scope key this token's claim was taken under
  /// ("QUEUE", or "SESSION:<queueSessionId>:<YYYY-MM-DD>"), so a fallback
  /// settlement at COMPLETED records the visit against the same scope.
  identityScopeKey    String?             @map("identity_scope_key")

  /// Phase 4: null on every token created on a queue with scheduleEnabled =
  /// false (which is every token before this feature and every token on a
  /// still-unscheduled queue after it — spec 4K). Set once, at creation, by
  /// queueSchedule.service.ts's assignment algorithm, and never reassigned
  /// afterward — an admin editing or deleting the session later changes
  /// nothing about a token that already holds it (the display fields below
  /// are a snapshot for exactly that reason).
  queueSessionId             String?       @map("queue_session_id")
  queueSession               QueueSession? @relation(fields: [queueSessionId], references: [id], onDelete: SetNull)
  /// The local calendar date (in the queue's timezone, midnight UTC of that
  /// date — never interpreted as a real instant) this session occurrence
  /// applies to. Together with queueSessionId this is what daily/session
  /// capacity counts against.
  assignedSessionDate        DateTime?     @map("assigned_session_date") @db.Date
  /// Snapshot of the session's start/end at the moment this token was
  /// assigned, so History/Live Tracking keep showing the same window even
  /// if the session is later edited or removed entirely (queueSessionId
  /// would go null via onDelete: SetNull, but these two survive).
  assignedSessionStartMinute Int?          @map("assigned_session_start_minute")
  assignedSessionEndMinute   Int?          @map("assigned_session_end_minute")
  /// ADR-048: the absolute instant the assigned session occurrence starts
  /// (assignedSessionDate + assignedSessionStartMinute, resolved in the
  /// queue's timezone at assignment time). A token may be assigned to a
  /// later session today, and until this instant passes it is *scheduled*:
  /// not callable, not skippable, not part of the FCFS head and given no
  /// ETA. Snapshotted like the minutes above, so a later session or
  /// timezone edit never moves it. Null = no gate (unscheduled queues, and
  /// tokens assigned before this column existed — always to an already-open
  /// session).
  assignedSessionStartsAt    DateTime?     @map("assigned_session_starts_at")

  notificationPreferences NotificationPreference[]
  /// At most one — this token's hold on a restricted queue (ADR-034).
  identityClaim           QueueIdentityClaim?
  /// V2 Checkpoint 5 (ADR-027): the authoritative multi-service selection —
  /// one row per selected service, backfilled from every pre-existing
  /// Token.serviceId at migration time. Always non-empty for every token,
  /// old and new alike.
  tokenServices           TokenService[]
  /// ADR-070: the ordered journey (empty for pre-journey tokens).
  journeySteps            TokenServiceStep[]

  @@unique([queueId, sequenceNumber])
  @@unique([deviceId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([queueId, status, createdAt])
  @@index([deviceId])
  @@index([counterId])
  // Phase 4 capacity counts: how many tokens already hold a slot on this
  // queue (daily) or this specific session (session) for one calendar date.
  @@index([queueId, assignedSessionDate])
  @@index([queueSessionId, assignedSessionDate])
  // The reminder scheduler runs globally (not organization-scoped) every
  // minute, selecting "currently WAITING, not yet reminded" tokens across
  // every organization — without this, that query would scan every
  // historical COMPLETED/SKIPPED token in the table each run.
  @@index([status, reminderSentAt])
  @@map("tokens")
}

/// V2 Checkpoint 5 (ADR-027): the customer's multi-service selection for one
/// token. A pure join table — composite primary key is the natural unique
/// constraint, no surrogate id needed. `onDelete: Restrict` on `service`
/// mirrors Token.serviceId's existing protection exactly (a service
/// referenced by any historical token, via either relation, cannot be
/// deleted) — deliberately not weakened by this migration.
model TokenService {
  tokenId String @map("token_id")
  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  serviceId String       @map("service_id")
  service   QueueService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([tokenId, serviceId])
  @@index([serviceId])
  @@map("token_services")
}

/// Phase 7 Step 7: one current FCM registration token per device. A device's
/// token can rotate (reinstall, Firebase-initiated refresh) — registering a
/// new one replaces the old one via upsert, never accumulates rows.
model DeviceFcmToken {
  id       String @id @default(uuid())
  deviceId String @unique @map("device_id")
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  fcmToken String @unique @map("fcm_token")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("device_fcm_tokens")
}

/// ADR-068: a standards-based Web Push subscription (Push API + VAPID) for a
/// browser installation of the iPhone/iPad Safari portal. The Device is the
/// browser installation (`deviceIdentifier` = its random
/// browserInstallationId), never a person and never a fingerprint.
///
/// `endpoint` is unique: one browser push subscription belongs to exactly one
/// installation; re-registering the same endpoint moves it. Rows whose push
/// service answered 404/410 are deleted, not kept as revoked.
model WebPushSubscription {
  id       String @id @default(uuid())
  deviceId String @map("device_id")
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh   String
  auth     String

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  /// Last time the push service accepted a message for it.
  lastSuccessAt DateTime? @map("last_success_at")
  /// Consecutive transient failures (5xx, timeouts) — reset on success.
  failureCount  Int       @default(0) @map("failure_count")

  @@index([deviceId])
  @@map("web_push_subscriptions")
}

/// Spec §15/§29.7's own data model, implemented now because Phase 7's
/// reminder dispatch is the first feature that actually needs it — Phase 5
/// (mobile) deliberately deferred this to a device-local-only preference
/// (ADR-018), never synced to the backend. Scoped to (deviceId, tokenId),
/// exactly as specified: a customer's reminder preference is per queue-join,
/// not a single global device setting. Absence of a row is the server-side
/// opt-out signal — reminder dispatch INNER JOINs this table, so a device/
/// token with no row here is never reminded, not defaulted to "enabled."
model NotificationPreference {
  id       String @id @default(uuid())
  deviceId String @map("device_id")
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tokenId  String @map("token_id")
  token    Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  /// Spec 7.18: customer-configurable, minimum 2 minutes — enforced by Zod
  /// at the registration endpoint, not just documented here. Null means the
  /// customer made no choice of their own, so the queue's
  /// defaultNotificationMinutes applies (ADR-062) — resolved when a reminder
  /// is dispatched, so a change to the queue's default takes effect at once.
  reminderMinutes      Int?    @map("reminder_minutes")
  vibrationEnabled     Boolean @default(true) @map("vibration_enabled")
  soundEnabled         Boolean @default(true) @map("sound_enabled")
  notificationsEnabled Boolean @default(true) @map("notifications_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([deviceId, tokenId])
  @@map("notification_preferences")
}

/// Append-only evidence trail (Phase 7 Step 4). organizationId/staffId are
/// plain scalar snapshots with deliberately NO Prisma relation to
/// Organization/Staff — an audit record is evidence of what happened, and
/// must survive both organization deletion (Organization cascades through
/// every other table via onDelete: Cascade) and staff deletion (DELETE
/// /api/staff/:staffId is a hard delete). staffEmail is captured too, so the
/// actor stays identifiable even after the Staff row is gone. `action` is a
/// plain string, not a Postgres enum, so the audit vocabulary can grow
/// without a schema migration for every new event — validated at the
/// application layer instead (src/constants/auditActions.ts).
model AuditLog {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  staffId        String @map("staff_id")
  staffEmail     String @map("staff_email")

  action           String
  entityType       String  @map("entity_type")
  entityId         String? @map("entity_id")
  metadata         Json?
  ipAddress        String? @map("ip_address")
  /// ADR-069: the Admin workspace the event belongs to — what an Admin's
  /// audit view is limited to. Null for organization-level events and for
  /// every event recorded before workspaces existed (those stay visible to
  /// the Organization Head and Managers only; never attributed by guess).
  workspaceAdminId String? @map("workspace_admin_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([organizationId, workspaceAdminId, createdAt])
  @@map("audit_logs")
}

/// DEPRECATED by ADR-035 — the four fixed windows a restricted queue used to
/// choose between. Retained only because Queue.repeatRestrictionPeriod keeps
/// its historical value.
enum RepeatRestrictionPeriod {
  ONCE_EVER
  DAILY
  WEEKLY
  MONTHLY
}

/// ADR-035: how a queue expresses its repeat limit.
enum RepeatRestrictionType {
  /// One visit, permanently. Needs no timezone and no arithmetic.
  ONCE_EVER
  /// A wait measured from the moment the visit was delivered, so every
  /// customer gets the same wait regardless of when they happened to arrive.
  DURATION
  /// A single cutoff instant shared by everyone — "nobody may rejoin before
  /// 31 December, 11:59 PM".
  UNTIL_DATETIME
}

/// The unit of a DURATION restriction. MINUTE through WEEK are exact elapsed
/// time and need no timezone. MONTH and YEAR are calendar increments — one
/// month after 31 January is 28 February, not "30 days later" — so they are
/// evaluated in the queue's own zone.
enum RepeatRestrictionUnit {
  MINUTE
  HOUR
  DAY
  WEEK
  MONTH
  YEAR
}

/// Which persistent detail identifies the customer for a repeat restriction.
/// There is deliberately no device/installation option here — the generated
/// installation identifier is reset by a reinstall, so it can never be the
/// authority for "this person already came" (ADR-034).
enum RepeatIdentityMode {
  /// DEPRECATED by ADR-037. Kept because removing a PostgreSQL enum value is
  /// destructive and buys nothing: no queue can be configured with either
  /// phone mode any more, and no SMS provider was ever integrated, so these
  /// two have never identified a real customer. They stay so that a value
  /// already written to a development database still parses.
  VERIFIED_PHONE
  CUSTOM_FIELD
  VERIFIED_PHONE_AND_CUSTOM_FIELD
  /// ADR-037: the customer proves access to an email address before it can
  /// stand as their identity. Replaces the phone modes, which waited on an
  /// SMS provider that was never integrated — email delivery already works
  /// in production for account verification and staff invitations.
  VERIFIED_EMAIL
  VERIFIED_EMAIL_AND_CUSTOM_FIELD
}

/// ADR-049: what one completed visit uses up.
enum RepeatRestrictionScope {
  /// The whole queue — the restriction applies across every session.
  QUEUE
  /// One session occurrence — a completed visit blocks only the same weekly
  /// session on the same calendar date.
  SESSION
}

enum IdentityClaimStatus {
  /// Held by a token that is still WAITING/CALLED/IN_PROGRESS. Stops the
  /// same person joining twice at once, from any number of installations.
  RESERVED
  /// The visit actually happened (COMPLETED), so the entitlement for this
  /// period is spent.
  CONSUMED
}

/// One customer's hold on a restricted queue for one restriction period.
///
/// Stores only an HMAC fingerprint of the normalized identity, never the
/// phone number or the NID/student-id itself: the raw answer already lives
/// in the token's form data under the existing staff-visible rules, and
/// duplicating it into a uniqueness table would spread it further for no
/// benefit. Two identities match iff their fingerprints match.
///
/// The unique constraint is the actual enforcement — a read-then-write
/// check cannot stop two simultaneous joins, and this rule has to hold
/// across devices, so it cannot lean on the per-installation lock either.
model QueueIdentityClaim {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queueId        String       @map("queue_id")
  queue          Queue        @relation(fields: [queueId], references: [id], onDelete: Cascade)

  /// HMAC-SHA256 over the queue id, identity mode and normalized identity
  /// material. Queue-scoped by construction, so a fingerprint is meaningless
  /// in any other queue and a policy change naturally starts a new namespace.
  identityFingerprint String  @map("identity_fingerprint")
  /// LEGACY (ADR-034): the fixed window this claim occupied — `EVER`,
  /// `2026-09-08`, `2026-W37` or `2026-09`. ADR-035 replaced fixed windows
  /// with an explicit `eligibleAgainAt`, which the migration computed from
  /// exactly these values. Kept, and now nullable, so the original window
  /// stays readable; nothing is written here any more.
  periodKey           String? @map("period_key")

  status IdentityClaimStatus @default(RESERVED)
  mode   RepeatIdentityMode

  /// When the visit was actually delivered. Null while merely RESERVED.
  consumedAt      DateTime? @map("consumed_at")
  /// When this customer may use the queue again. Null together with a
  /// non-null consumedAt means never — a once-ever queue. Meaningless while
  /// RESERVED, because an active token blocks regardless.
  eligibleAgainAt DateTime? @map("eligible_again_at")

  /// ADR-035: exactly one claim per (queue, identity) governs eligibility at
  /// a time; older ones are kept for history rather than deleted. Rather
  /// than a partial unique index — which Prisma cannot express, and which
  /// would therefore read as schema drift forever — the live row holds the
  /// literal slot value ACTIVE while a superseded row takes its own id.
  /// Ids are unique, so history can grow without ever colliding, and the
  /// unique index below still admits only one governing claim.
  claimSlot    String    @default("ACTIVE") @map("claim_slot")
  supersededAt DateTime? @map("superseded_at")

  /// ADR-049: which entitlement this claim spends. "QUEUE" (the default, and
  /// every claim before this column existed) covers every join to the
  /// queue. "SESSION:<queueSessionId>:<YYYY-MM-DD>" covers only joins
  /// assigned to that same session occurrence — the weekly QueueSession row
  /// alone is not enough, since one row recurs every week. Built from ids
  /// and the local calendar date, never from display text. Part of the
  /// unique index, so one claim per (identity, scope) governs at a time.
  entitlementScopeKey String @default("QUEUE") @map("entitlement_scope_key")

  /// The token holding this claim. Unique so a token can never hold two.
  tokenId String @unique @map("token_id")
  token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([queueId, identityFingerprint, entitlementScopeKey, claimSlot])
  @@index([queueId, status])
  @@index([queueId, identityFingerprint])
  @@map("queue_identity_claims")
}

/// A phone-number verification challenge, used only to prove control of a
/// number before joining a queue that identifies customers by phone.
///
/// Deliberately separate from the service-start OTP (Token.serviceStartOtp*)
/// in every respect — different model, routes, secret purpose, lifetime and
/// attempt budget. The two prove different things to different parties and
/// must not share machinery (ADR-034).
model PhoneVerification {
  id      String @id @default(uuid())
  queueId String @map("queue_id")
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  /// Fingerprint of the normalized number, not the number itself — this row
  /// only ever needs to answer "is this the same number as before".
  phoneFingerprint String @map("phone_fingerprint")
  /// HMAC of the code. One-way: nothing ever needs to read the code back,
  /// unlike the service-start OTP, which the owning customer re-fetches.
  codeHash         String @map("code_hash")

  expiresAt      DateTime  @map("expires_at")
  failedAttempts Int       @default(0) @map("failed_attempts")
  consumedAt     DateTime? @map("consumed_at")
  /// Drives the resend cooldown without a second table.
  lastSentAt     DateTime  @default(now()) @map("last_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([queueId, phoneFingerprint])
  @@index([expiresAt])
  @@map("phone_verifications")
}

/// ADR-037: an email verification challenge, proving a customer can read a
/// mailbox before that address may stand as their repeat-visit identity.
///
/// Deliberately its own model rather than a generalisation of
/// PhoneVerification: that table is dormant (no SMS provider was ever
/// integrated) and renaming its columns would be a destructive change to
/// earn nothing. Deliberately separate from the Staff email-verification
/// columns too — proving a customer can read a mailbox is a different
/// question from an owner proving they control an account, with a different
/// lifetime, a different audience and a different secret purpose.
model CustomerEmailVerification {
  id      String @id @default(uuid())
  queueId String @map("queue_id")
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  /// Fingerprint of the normalized address, never the address itself: this
  /// row only ever has to answer "is this the same mailbox as before", and
  /// the identity system never needs a second copy of a customer's email.
  emailFingerprint String @map("email_fingerprint")
  /// HMAC of the code. One-way — nothing ever reads the code back, unlike
  /// the service-start OTP which the owning customer re-fetches.
  codeHash         String @map("code_hash")

  expiresAt      DateTime  @map("expires_at")
  failedAttempts Int       @default(0) @map("failed_attempts")
  consumedAt     DateTime? @map("consumed_at")
  /// Drives the resend cooldown without a second table.
  lastSentAt     DateTime  @default(now()) @map("last_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([queueId, emailFingerprint])
  @@index([expiresAt])
  @@map("customer_email_verifications")
}

/// ADR-057: what a membership-removal request asks for. Derived by the server
/// from who is asking about whom, never chosen by the client.
enum MembershipRequestType {
  /// A STAFF or ADMIN member asking to leave the organization.
  SELF_LEAVE
  /// An ADMIN asking the owner to remove another ADMIN.
  ADMIN_REMOVAL_REQUEST
}

enum MembershipRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// Withdrawn by the requester, or made moot because the target left the
  /// organization by some other route before the owner reviewed it.
  CANCELLED
}

/// ADR-057: a request for the owner to end someone's membership. Nobody may
/// remove themselves directly, and an admin may not directly remove another
/// admin — those changes go through the owner here.
///
/// requester/target/reviewer are snapshot columns with no relation to Staff,
/// like AuditLog: approving a request deletes the target's Staff row, and the
/// request must survive as the record of why.
model MembershipRemovalRequest {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  requestType MembershipRequestType   @map("request_type")
  status      MembershipRequestStatus @default(PENDING)
  reason      String?

  requesterId    String @map("requester_id")
  requesterName  String @map("requester_name")
  requesterEmail String @map("requester_email")

  targetStaffId String    @map("target_staff_id")
  targetName    String    @map("target_name")
  targetEmail   String    @map("target_email")
  targetRole    StaffRole @map("target_role")

  reviewedAt     DateTime? @map("reviewed_at")
  reviewedById   String?   @map("reviewed_by_id")
  reviewedByName String?   @map("reviewed_by_name")
  reviewNote     String?   @map("review_note")

  /// One pending request per (target, type). A pending row holds the literal
  /// "PENDING"; closing it moves the slot to the row's own id, so history can
  /// grow while the unique index below still admits only one open request —
  /// the ADR-035 claimSlot pattern, instead of a partial index Prisma cannot
  /// express.
  activeSlot String @default("PENDING") @map("active_slot")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([targetStaffId, requestType, activeSlot])
  @@index([organizationId, status, createdAt])
  @@map("membership_removal_requests")
}

/// ADR-058: a "forgot password" link. Only the SHA-256 hash of the emailed
/// value is stored, like Session.refreshTokenHash. Single use (usedAt), short
/// lived (expiresAt), and every other outstanding link for the account is
/// deleted when one is redeemed or a newer one is issued.
model PasswordResetToken {
  id        String    @id @default(uuid())
  staffId   String    @map("staff_id")
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([staffId, createdAt])
  @@map("password_reset_tokens")
}

/// ADR-070: which services a counter handles. A counter with no rows handles
/// every service of its queue, so routing is opt-in per counter.
model CounterService {
  counterId String       @map("counter_id")
  counter   Counter      @relation(fields: [counterId], references: [id], onDelete: Cascade)
  serviceId String       @map("service_id")
  service   QueueService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([counterId, serviceId])
  @@index([serviceId])
  @@map("counter_services")
}

/// ADR-070: the queue's recommended journey, prefilled for people choosing
/// their services. Positions are 1-based and contiguous; the same service may
/// appear more than once (never twice in a row).
model QueueRecommendedStep {
  id        String       @id @default(uuid())
  queueId   String       @map("queue_id")
  queue     Queue        @relation(fields: [queueId], references: [id], onDelete: Cascade)
  position  Int
  serviceId String       @map("service_id")
  service   QueueService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([queueId, position])
  @@map("queue_recommended_steps")
}

/// ADR-070: the state of one step of a journey.
enum JourneyStepStatus {
  PENDING
  CALLED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

/// ADR-070: one step of a person's ordered service journey. The list of
/// (stepNumber, serviceId) is fixed when the token is created and never
/// edited; only each step's progress (status, who served it, a referral to
/// another counter) is recorded as it happens.
model TokenServiceStep {
  id         String            @id @default(uuid())
  tokenId    String            @map("token_id")
  token      Token             @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  stepNumber Int               @map("step_number")
  serviceId  String            @map("service_id")
  service    QueueService      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  status     JourneyStepStatus @default(PENDING)

  /// Who handled the step (set when it is called).
  counterId   String?   @map("counter_id")
  counter     Counter?  @relation("StepCounter", fields: [counterId], references: [id], onDelete: SetNull)
  staffId     String?   @map("staff_id")
  /// ADR-071: the operator's name when the step was called — history keeps
  /// it through a rename or removal. Null only where it was never known.
  staffName   String?   @map("staff_name")
  calledAt    DateTime? @map("called_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  /// A referral sends this step to a specific counter, ahead of that
  /// counter's normal line (never ahead of the person it is serving).
  referredToCounterId   String?   @map("referred_to_counter_id")
  referredToCounter     Counter?  @relation("StepReferredTo", fields: [referredToCounterId], references: [id], onDelete: SetNull)
  referredFromCounterId String?   @map("referred_from_counter_id")
  referredFromCounter   Counter?  @relation("StepReferredFrom", fields: [referredFromCounterId], references: [id], onDelete: SetNull)
  referredByStaffId     String?   @map("referred_by_staff_id")
  /// ADR-071: who referred, as named at the time.
  referredByName        String?   @map("referred_by_name")
  referredAt            DateTime? @map("referred_at")
  referralNote          String?   @map("referral_note")

  @@unique([tokenId, stepNumber])
  @@index([serviceId])
  @@index([referredToCounterId])
  @@index([counterId])
  @@map("token_service_steps")
}

// ---------------------------------------------------------------------------
// ADR-071: governance history — Organization Head tenure and succession,
// Admin workspace transfers, and the receipt left by organization deletion.
// Every row is a snapshot (names and emails as they were), never a live join,
// so removing an account later never rewrites who did what. Append-only:
// database triggers (migration 20261008000100) refuse updates to finished
// history and refuse deletion while the organization still exists.
// ---------------------------------------------------------------------------

enum HeadTenureStartType {
  /// The person who registered the organization.
  FOUNDING
  /// Took over through an accepted succession.
  SUCCESSION
  /// Recorded when tenure history was introduced, for an existing Head.
  BACKFILL
}

enum HeadSuccessionReason {
  RETIREMENT
  RESIGNATION
  END_OF_TERM
  ORGANIZATIONAL_RESTRUCTURING
  CHANGE_OF_RESPONSIBILITY
  PERSONAL_REASONS
  OTHER
}

enum HeadSuccessionStatus {
  /// Started; the current Head has not yet entered the emailed code.
  AWAITING_VERIFICATION
  /// Verified; the successor's one-time link is out.
  AWAITING_ACCEPTANCE
  COMPLETED
  CANCELLED
  DECLINED
  EXPIRED
}

enum AdminTransferOutcome {
  /// The previous Admin became an Organization Manager.
  MANAGER
  /// The previous Admin became an Executive of the new Admin's workspace.
  EXECUTIVE
  /// The previous Admin left the organization.
  REMOVED
}

/// One person's time as Organization Head. Exactly one row per organization
/// has `endedAt` null (partial unique index). `staffId` is an identity
/// snapshot, deliberately not a foreign key: a former Head's account is
/// removed at handover, and their tenure must outlive it.
model OrganizationHeadTenure {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  staffId   String?             @map("staff_id")
  name      String
  email     String
  startedAt DateTime            @default(now()) @map("started_at")
  startType HeadTenureStartType @map("start_type")

  endedAt   DateTime?             @map("ended_at")
  endReason HeadSuccessionReason? @map("end_reason")
  /// Private to the Organization Head (ADR-071 D5).
  endNote   String?               @map("end_note")

  /// The tenure this one followed, and the succession that started it.
  predecessorTenureId String? @unique @map("predecessor_tenure_id")
  successionId        String? @unique @map("succession_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, startedAt])
  @@map("organization_head_tenures")
}

/// A handover of the Organization Head role. Only hashes of the emailed
/// verification code and of the successor's link are stored, never the raw
/// values. At most one is in progress per organization (partial unique
/// index on the two open statuses).
model HeadSuccession {
  id             String               @id @default(uuid())
  organizationId String               @map("organization_id")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         HeadSuccessionStatus @default(AWAITING_VERIFICATION)

  initiatedByStaffId String @map("initiated_by_staff_id")
  initiatedByName    String @map("initiated_by_name")
  initiatedByEmail   String @map("initiated_by_email")

  successorEmail   String  @map("successor_email")
  successorName    String  @map("successor_name")
  /// Set when the successor is already a member of the organization.
  successorStaffId String? @map("successor_staff_id")

  reason HeadSuccessionReason
  note   String?

  verificationCodeHash  String?   @map("verification_code_hash")
  verificationExpiresAt DateTime? @map("verification_expires_at")
  verificationAttempts  Int       @default(0) @map("verification_attempts")

  successorTokenHash      String?   @unique @map("successor_token_hash")
  successorTokenExpiresAt DateTime? @map("successor_token_expires_at")

  verifiedAt  DateTime? @map("verified_at")
  acceptedAt  DateTime? @map("accepted_at")
  declinedAt  DateTime? @map("declined_at")
  cancelledAt DateTime? @map("cancelled_at")
  expiredAt   DateTime? @map("expired_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId, createdAt])
  @@map("head_successions")
}

/// An Admin workspace handed to a replacement Admin: the queue, its
/// Executives and its operations moved; earlier audit rows stay with the
/// Admin who performed them.
model AdminWorkspaceTransfer {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Null when the Admin had Executives but no live queue.
  queueId   String? @map("queue_id")
  queueName String? @map("queue_name")

  oldAdminId      String               @map("old_admin_id")
  oldAdminName    String               @map("old_admin_name")
  oldAdminEmail   String               @map("old_admin_email")
  oldAdminOutcome AdminTransferOutcome @map("old_admin_outcome")

  newAdminId           String    @map("new_admin_id")
  newAdminName         String    @map("new_admin_name")
  newAdminEmail        String    @map("new_admin_email")
  /// The replacement's role just before the transfer (ADMIN, MANAGER or STAFF).
  newAdminPreviousRole StaffRole @map("new_admin_previous_role")

  transferredById    String @map("transferred_by_id")
  transferredByName  String @map("transferred_by_name")
  transferredByEmail String @map("transferred_by_email")

  reason          String
  note            String?
  executivesMoved Int     @map("executives_moved")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("admin_workspace_transfers")
}

/// ADR-071 D8: the only trace an organization leaves once it is permanently
/// deleted — its detailed audit and governance history go with it.
model OrganizationDeletionReceipt {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  organizationName String   @map("organization_name")
  deletedByStaffId String   @map("deleted_by_staff_id")
  deletedByName    String   @map("deleted_by_name")
  deletedByEmail   String   @map("deleted_by_email")
  deletedAt        DateTime @default(now()) @map("deleted_at")

  @@index([organizationId])
  @@map("organization_deletion_receipts")
}
