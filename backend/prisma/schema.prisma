generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum StaffRole {
  OWNER
  ADMIN
  STAFF
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  /// V2 Checkpoint 2 (ADR-024): a just-registered owner starts here, not
  /// ACTIVE, until they prove ownership of the supplied email address.
  /// Never set by createStaff/updateStaff (staff invites remain instantly
  /// ACTIVE, unchanged from V1) — only register() uses this value.
  PENDING_EMAIL_VERIFICATION
}

enum QueueStatus {
  ACTIVE
  PAUSED
  INACTIVE
}

enum CounterStatus {
  ACTIVE
  ON_BREAK
  OFFLINE
}

/// Lowercase to match the wire format used throughout the spec's form-field
/// JSON examples (e.g. "type": "phone") — deliberately not uppercase like the
/// other status enums, to avoid a translation layer between API and storage.
enum FormFieldType {
  text
  number
  email
  phone
  date
  dropdown
  radio
  checkbox
}

enum TokenStatus {
  WAITING
  CALLED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

/// Device identity is deliberately global (no organizationId) per spec 7.19 /
/// ADR-011 — a device is a lightweight per-installation identifier, not a
/// tenant-scoped account.
enum DeviceStatus {
  ACTIVE
  BLOCKED
}

/// A tenant. Every organization-owned record must trace back to one Organization,
/// and every organization-scoped query must be filtered by the authenticated
/// staff member's organizationId — never by a client-supplied id.
model Organization {
  id        String             @id @default(uuid())
  name      String
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  staff        Staff[]
  queues       Queue[]
  tokens       Token[]
  deviceBlocks OrganizationDeviceBlock[]

  @@map("organizations")
}

/// email is globally unique for MVP (ADR-005): one staff identity maps to exactly
/// one organization. No cross-organization staff memberships in this phase.
model Staff {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         StaffRole
  permissions  String[]
  status       StaffStatus @default(ACTIVE)
  lastLoginAt  DateTime?   @map("last_login_at")

  /// V2 Checkpoint 2 (ADR-024) — only ever populated while status is
  /// PENDING_EMAIL_VERIFICATION; all three are cleared back to null on
  /// successful verification. Only the hash is ever persisted (never the
  /// raw token), same pattern as Session.refreshTokenHash.
  emailVerificationTokenHash  String?   @map("email_verification_token_hash")
  /// 15-minute verification-link expiry — independent of registrationExpiresAt.
  emailVerificationExpiresAt  DateTime? @map("email_verification_expires_at")
  /// 1-hour pending-registration deadline, set once at registration and never
  /// extended by a resend — the cleanup scheduler deletes the organization
  /// (cascading to this row) once this passes while still unverified.
  registrationExpiresAt       DateTime? @map("registration_expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions Session[]
  counters Counter[]

  @@index([organizationId])
  @@map("staff")
}

/// DB-backed refresh session (ADR-013). Only a SHA-256 hash of the refresh token
/// is stored, never the raw token. Rotation on use: the presented session is
/// revoked and replaced by a new row linked via replacedBySessionId. Presenting
/// an already-revoked token's hash is treated as token reuse.
model Session {
  id      String @id @default(uuid())
  staffId String @map("staff_id")
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique @map("refresh_token_hash")

  createdAt           DateTime  @default(now()) @map("created_at")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedBySessionId String?   @map("replaced_by_session_id")

  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")

  @@index([staffId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A queue represents one service line, owned by exactly one Organization.
/// deletedAt is archival state (ADR-012) and is intentionally independent of
/// `status` — a queue is never "deleted" via status, and status is never
/// implied by deletedAt (ADR-015).
model Queue {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name                       String
  description                String?
  status                     QueueStatus @default(ACTIVE)
  clientTerminology          String?     @map("client_terminology")
  tokenPrefix                String      @map("token_prefix")
  startingNumber             Int         @default(1) @map("starting_number")
  nextTokenNumber            Int         @default(1) @map("next_token_number")
  baseTimeMinutes            Int         @default(5) @map("base_time_minutes")
  defaultNotificationMinutes Int         @default(10) @map("default_notification_minutes")
  formVersion                Int         @default(1) @map("form_version")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  services   QueueService[]
  counters   Counter[]
  formFields QueueFormField[]
  tokens     Token[]

  @@index([organizationId])
  @@map("queues")
}

model QueueService {
  id      String @id @default(uuid())
  queueId String @map("queue_id")
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  serviceName     String  @map("service_name")
  description     String?
  durationMinutes Int     @map("duration_minutes")
  isActive        Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tokens Token[]

  @@index([queueId])
  @@map("queue_services")
}

model Counter {
  id      String @id @default(uuid())
  queueId String @map("queue_id")
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  name    String
  status  CounterStatus @default(OFFLINE)
  staffId String?       @map("staff_id")
  staff   Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tokens Token[]

  @@index([queueId])
  @@index([staffId])
  @@map("counters")
}

/// Versioned per ADR-009: a PUT replace never mutates or deletes existing
/// rows — it writes a new set of rows at `version = Queue.formVersion + 1`
/// and bumps Queue.formVersion, both inside one transaction. Old versions
/// stay exactly as they were, so historical Token.formData (added in a later
/// phase) always resolves against the field definitions it was submitted
/// under.
model QueueFormField {
  id      String @id @default(uuid())
  queueId String @map("queue_id")
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  key         String
  label       String
  type        FormFieldType
  required    Boolean       @default(false)
  placeholder String?
  options     String[]      @default([])
  sortOrder   Int           @default(0) @map("sort_order")
  version     Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([queueId, version, key])
  @@index([queueId, version])
  @@map("queue_form_fields")
}

/// One row per mobile installation (ADR-011). No organizationId: a device is
/// not a tenant-scoped identity, it is a lightweight abuse-prevention handle
/// the customer-facing token API resolves/creates on demand.
model Device {
  id               String       @id @default(uuid())
  deviceIdentifier String       @unique @map("device_identifier")
  status           DeviceStatus @default(ACTIVE)
  lastSeenAt       DateTime?    @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tokens                  Token[]
  fcmToken                DeviceFcmToken?
  notificationPreferences NotificationPreference[]
  organizationBlocks      OrganizationDeviceBlock[]

  @@map("devices")
}

/// Organization-scoped block relationship — the authoritative source for
/// device blocking (see token.service.ts::createToken). Device remains a
/// deliberately global identity (see comment above); this join table is what
/// lets Organization A block a device without affecting Organization B/C,
/// via the compound unique key. Device.status/DeviceStatus.BLOCKED are
/// intentionally left in place, unused for authorization — removing them and
/// backfilling historical blocks into this table are separate, deferred,
/// reviewed operations, not part of this change.
model OrganizationDeviceBlock {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deviceId       String       @map("device_id")
  device         Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([organizationId, deviceId])
  @@map("organization_device_blocks")
}

/// sequenceNumber is the atomically-allocated integer (ADR-003); serialNumber
/// is the derived display string (tokenPrefix + zero-padded sequenceNumber).
/// formVersion is a plain integer snapshot of Queue.formVersion at creation
/// time — not a foreign key — so historical form definitions stay resolvable
/// (queueId, version) even after the queue's live form changes (ADR-009).
model Token {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queueId        String       @map("queue_id")
  queue          Queue        @relation(fields: [queueId], references: [id], onDelete: Cascade)
  serviceId      String       @map("service_id")
  service        QueueService @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  counterId      String?      @map("counter_id")
  counter        Counter?     @relation(fields: [counterId], references: [id], onDelete: SetNull)
  deviceId       String       @map("device_id")
  device         Device       @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  sequenceNumber Int         @map("sequence_number")
  serialNumber   String      @map("serial_number")
  status         TokenStatus @default(WAITING)

  formData    Json @map("form_data")
  formVersion Int  @map("form_version")

  idempotencyKey String @map("idempotency_key")

  createdAt   DateTime  @default(now()) @map("created_at")
  calledAt    DateTime? @map("called_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  skippedAt   DateTime? @map("skipped_at")

  /// V2 Checkpoint 4 (ADR-026): staff-set override of how long this specific
  /// customer's service is expected to take, in minutes. Null means "use
  /// service.durationMinutes" (the pre-existing default). Only ever set
  /// while the token is CALLED/IN_PROGRESS ("an active customer" per the
  /// product requirement) — never touched by WAITING/terminal tokens.
  requiredDurationMinutes Int? @map("required_duration_minutes")

  /// Phase 7 Step 7 dedup claim: set exactly once, via a conditional
  /// (compare-and-swap) UPDATE mirroring the existing state-machine pattern,
  /// the moment a reminder dispatch attempt claims this token — before the
  /// actual FCM send, so a crash mid-send under-delivers rather than
  /// duplicates. The smallest correct persistence for "has this token
  /// already been reminded," reusing this existing model rather than a new
  /// table (survives scheduler restarts and repeated dispatch calls, unlike
  /// an in-memory Set).
  reminderSentAt DateTime? @map("reminder_sent_at")

  notificationPreferences NotificationPreference[]

  @@unique([queueId, sequenceNumber])
  @@unique([deviceId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([queueId, status, createdAt])
  @@index([deviceId])
  @@index([counterId])
  // The reminder scheduler runs globally (not organization-scoped) every
  // minute, selecting "currently WAITING, not yet reminded" tokens across
  // every organization — without this, that query would scan every
  // historical COMPLETED/SKIPPED token in the table each run.
  @@index([status, reminderSentAt])
  @@map("tokens")
}

/// Phase 7 Step 7: one current FCM registration token per device. A device's
/// token can rotate (reinstall, Firebase-initiated refresh) — registering a
/// new one replaces the old one via upsert, never accumulates rows.
model DeviceFcmToken {
  id       String @id @default(uuid())
  deviceId String @unique @map("device_id")
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  fcmToken String @unique @map("fcm_token")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("device_fcm_tokens")
}

/// Spec §15/§29.7's own data model, implemented now because Phase 7's
/// reminder dispatch is the first feature that actually needs it — Phase 5
/// (mobile) deliberately deferred this to a device-local-only preference
/// (ADR-018), never synced to the backend. Scoped to (deviceId, tokenId),
/// exactly as specified: a customer's reminder preference is per queue-join,
/// not a single global device setting. Absence of a row is the server-side
/// opt-out signal — reminder dispatch INNER JOINs this table, so a device/
/// token with no row here is never reminded, not defaulted to "enabled."
model NotificationPreference {
  id       String @id @default(uuid())
  deviceId String @map("device_id")
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tokenId  String @map("token_id")
  token    Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  /// Spec 7.18: customer-configurable, minimum 2 minutes — enforced by Zod
  /// at the registration endpoint, not just documented here.
  reminderMinutes      Int     @map("reminder_minutes")
  vibrationEnabled     Boolean @default(true) @map("vibration_enabled")
  soundEnabled         Boolean @default(true) @map("sound_enabled")
  notificationsEnabled Boolean @default(true) @map("notifications_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([deviceId, tokenId])
  @@map("notification_preferences")
}

/// Append-only evidence trail (Phase 7 Step 4). organizationId/staffId are
/// plain scalar snapshots with deliberately NO Prisma relation to
/// Organization/Staff — an audit record is evidence of what happened, and
/// must survive both organization deletion (Organization cascades through
/// every other table via onDelete: Cascade) and staff deletion (DELETE
/// /api/staff/:staffId is a hard delete). staffEmail is captured too, so the
/// actor stays identifiable even after the Staff row is gone. `action` is a
/// plain string, not a Postgres enum, so the audit vocabulary can grow
/// without a schema migration for every new event — validated at the
/// application layer instead (src/constants/auditActions.ts).
model AuditLog {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  staffId        String @map("staff_id")
  staffEmail     String @map("staff_email")

  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")
  metadata   Json?
  ipAddress  String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
