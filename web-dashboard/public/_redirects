# ADR-068: the iPhone/iPad Safari portal is its own page in the build.
# Static files (portal-sw.js, portal.webmanifest) live outside /visit/ so
# this rewrite never shadows them. Everything else keeps Cloudflare Pages'
# single-page fallback to index.html (the staff dashboard).
# The target is extensionless: Pages serves portal.html for /portal, whereas
# /portal.html itself answers with a redirect to /portal.
/visit /portal 200
/visit/* /portal 200
