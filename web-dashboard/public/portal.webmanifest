{
  "name": "LiveQueue",
  "short_name": "LiveQueue",
  "description": "Join a queue and follow your turn live.",
  "id": "/visit/",
  "scope": "/visit/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#0f539e",
  "icons": [
    {
      "src": "/portal-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/portal-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}
