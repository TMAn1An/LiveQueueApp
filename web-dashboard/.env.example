# The backend's origin (no trailing slash, no /api).
#
# REQUIRED for every build: `npm run build` refuses to run without it, so a
# deployed dashboard can never silently point at localhost. In production set
# it in the hosting provider's build environment variables, not in a file.
#
# Optional for `npm run dev` only, which falls back to http://localhost:4000, the
# backend's own default port (backend/.env.example PORT=4000). If your backend runs
# on another port, set it in web-dashboard/.env.
VITE_API_BASE_URL=http://localhost:4000

# ADR-068 (optional): the public origin of the iPhone/iPad portal printed in
# the organization QR code (https://<host>/visit/<code>). Defaults to the
# dashboard's own origin, which serves the portal too.
VITE_PUBLIC_PORTAL_URL=
